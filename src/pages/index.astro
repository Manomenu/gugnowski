---
import Base from "../layouts/Base.astro";
import { sortedPosts, formatDate, readingMinutes } from "../posts";
const topics = ["RAG", "chatboty konwersacyjne", "ewaluacja chatbotów", "observability", "fine-tuning", "agentic engineering"];
---
<Base title="gugnowski / blog" description="Blog o AI engineeringu w praktyce: RAG, chatboty, ewaluacja, fine-tuning i spec-driven development z agentami.">
  <main class="wrap home">
    <section class="intro">
      <p class="eyebrow">AI engineering, z produkcji</p>
      <h1>Piszę o tym, czego nauczyłem się, budując systemy AI.</h1>
      <p class="lead">Każdy wpis to research albo doświadczenie z prawdziwego projektu: co działa, co nie, i na jakich dowodach to opieram.</p>
      <ul class="topics" aria-label="Tematy">{topics.map((t) => <li>{t}</li>)}</ul>
    </section>

    <section aria-labelledby="posts-title">
      <h2 id="posts-title" class="list-title">Wpisy</h2>
      <ol class="posts">
        {sortedPosts.map((p) => (
          <li>
            <a class="post-card" href={`/${p.slug}/`}>
              <div class="meta">
                <span class="kind">{p.kind}</span>
                <time datetime={p.date}>{formatDate(p.date)}</time>
                <span>{readingMinutes(p.html)} min czytania</span>
              </div>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              <div class="tags">{p.tags.map((t) => <span>#{t.replace(/ /g, "-")}</span>)}</div>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Base>
<style>
  .home { max-width: 820px; }
  .intro { padding-block: 64px 40px; }
  .eyebrow { font: 600 .78rem var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin: 0 0 14px; }
  h1 { font-size: clamp(2rem, 5vw, 2.9rem); margin: 0 0 16px; letter-spacing: -.025em; }
  .lead { font-size: 1.15rem; color: var(--muted); max-width: 60ch; margin: 0 0 22px; }
  .topics { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .topics li { font: 500 .8rem var(--mono); color: var(--ink); background: var(--card); border: 1px solid var(--line); padding: 4px 10px; border-radius: 99px; }
  .list-title { font: 600 .78rem var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--line); padding-bottom: 10px; margin: 0 0 18px; }
  .posts { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .post-card { display: block; text-decoration: none; color: inherit; background: var(--paper); border: 1px solid var(--line); border-radius: 14px; padding: 22px 24px; transition: border-color .15s, transform .15s; }
  .post-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .post-card h3 { font-size: 1.45rem; margin: 8px 0 8px; }
  .post-card p { margin: 0 0 12px; color: var(--muted); }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; font-size: .84rem; color: var(--muted); }
  .kind { font: 600 .72rem var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--accent); background: var(--accent-soft); padding: 2px 8px; border-radius: 6px; }
  .tags { display: flex; flex-wrap: wrap; gap: 4px 12px; font: .8rem var(--mono); color: var(--note); }
</style>
